# O que NAO entra no historico do Git
# (sao pastas grandes ou coisas que o programa recria sozinho)

# as bibliotecas baixadas (centenas de MB) - so e preciso no seu computador
.venv/

# resultado das compilacoes (o .exe que vai para a Area de Trabalho)
build/
dist/

# arquivos antigos guardados so por seguranca (scripts de teste velhos, backups)
_arquivo_morto/

# pasta de sobras dos testes (prints, audios, scripts de teste). O que
# sobrar aqui e temporario e NAO entra no historico do Git.
_tmp/

# configuracao de outras IAs que trabalham neste computador (nao e do projeto)
.codex/

# cache do Python
__pycache__/
*.pyc

# arquivos de erro do programa
erro.log
*.log

# o .exe compilado (e gerado, nao pertence ao historico)
*.exe

# configuracao pessoal (tem as chaves de API - NUNCA versionar)
config.json
_troca/
